# =============================================================================
# databases-stack — ortam değişkenleri
# =============================================================================
# `./install.sh` bu dosyayı sizin için .env olarak üretir; parolaları ve
# anahtarları rastgele oluşturur. Elle doldurmak isterseniz kopyalayın:
#     cp .env.example .env
#
# ⚠️ BELLEK/BOYUT AYARI BURADA YOKTUR — BİLEREK.
# Hangi motorun ne kadar RAM alacağını, buffer pool'un, JVM heap'in, WiredTiger
# cache'inin kaç MB olacağını controller sunucunun GERÇEK RAM'ini ölçerek
# hesaplar ve state/tuning.env dosyasına yazar. Siz bir şey girmezsiniz.
# Hesabı görmek için: ./stack.sh plan <motor>   (ya da dashboard'daki kart)
# =============================================================================


# ─── ZORUNLU ──────────────────────────────────────────────────────────────────

# Tüm veritabanlarının ortak parolası. install.sh 32 karakterlik rastgele bir
# değer üretir. MSSQL politikası gereği güçlü olmalı (8+ karakter; büyük harf,
# küçük harf, rakam ve özel karakterden en az üçü).
#   openssl rand -base64 32 | tr -d '+/='
DB_PASSWORD=

# Sunucunun iç ağdaki adresi ya da host adı. TLS sertifikasına SAN olarak
# yazılır; Kafka'nın advertised listener'ı ve Neo4j Browser'ın bolt adresi de
# bunu kullanır (tarayıcıdan doğrudan bağlandıkları için "localhost" olamaz).
STACK_HOST=192.168.1.10

# Stack'in host üzerindeki MUTLAK yolu. install.sh otomatik yazar.
# Controller compose'u kendi container'ının içinden çağırdığı için bind-mount
# yollarının mutlak olması şart — göreli yol orada yanlış çözülür.
STACK_DIR=/opt/databases

# Controller API'sinin paylaşılan sırrı. Yalnızca gateway bilir; başka bir
# container doğrudan controller'a istek atarsa 401 alır. install.sh üretir.
CONTROLLER_TOKEN=

# Kibana'nın kayıtlı nesneleri şifrelemek için kullandığı 32+ karakterlik
# anahtar. Değişirse Kibana'daki kayıtlı objeler okunamaz hale gelir.
KIBANA_ENCRYPTION_KEY=


# ─── PANEL / DASHBOARD ERİŞİMİ ────────────────────────────────────────────────

# Dashboard ve tüm panellerin önündeki basic auth kullanıcısı (gateway).
PANEL_USER=admin
# Boş bırakılırsa DB_PASSWORD kullanılır. Ayrı vermeniz ÖNERİLİR: böylece panel
# parolası sızsa bile veritabanı root parolası ele geçmez.
PANEL_PASSWORD=

# pgAdmin giriş bilgileri
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=


# ─── MOTOR BAŞINA PAROLALAR (opsiyonel) ───────────────────────────────────────
# Boş bırakılan her biri DB_PASSWORD'a düşer. Üretimde ayırmanız önerilir —
# tek parola sızıntısı 12 motoru birden açar.
#
# NOT: özel karakter (@ : / ? #) içeren parolalar bazı istemcilerin bağlantı
# URI'lerini bozabilir. Sorun yaşamamak için alfanümerik üretin:
#   openssl rand -base64 32 | tr -d '+/='
MARIADB_PASSWORD=
POSTGRES_PASSWORD=
MONGO_PASSWORD=
REDIS_PASSWORD=
MSSQL_PASSWORD=
CASSANDRA_PASSWORD=
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
RABBITMQ_PASSWORD=
CLICKHOUSE_PASSWORD=
NEO4J_PASSWORD=
MINIO_ROOT_PASSWORD=

# Uygulamanızın bağlanacağı kısıtlı kullanıcı (setup_db_users.sh oluşturur).
APP_USER=appuser
APP_PASSWORD=


# ─── SÜRÜMLER ─────────────────────────────────────────────────────────────────
# Hepsi sabitlenmiştir (`latest` yok) — sürpriz güncelleme gelmez.
# ⚠️ Var olan bir kurulumda MAJOR sürüm değiştirmek veri taşıma gerektirir:
#    MongoDB ve PostgreSQL için önce docs/UPGRADE.md okuyun. install.sh mevcut
#    volume'ları algılayıp uyumlu sürümü otomatik sabitler.
MARIADB_VERSION=11.4
POSTGRES_VERSION=16
MONGO_VERSION=7.0
REDIS_VERSION=8-alpine
MSSQL_VERSION=2022-latest
# SQL Server sürüm TÜRÜ. Varsayılan Express: ÜCRETSİZ ve ÜRETİMDE DE
# kullanılabilir. Sınırları: veritabanı başına 10 GB, ~1.4 GB tampon havuzu,
# en fazla 4 çekirdek — iç uygulamalar için genelde yeter.
#   Developer  → tüm özellikler açık, ücretsiz, ama YALNIZ geliştirme/test
#   Standard / Enterprise → satın alınmış lisans gerekir
MSSQL_PID=Express
CASSANDRA_VERSION=5.0
ELASTIC_VERSION=8.15.3
KAFKA_VERSION=3.9.0
RABBITMQ_VERSION=3.13-management-alpine
CLICKHOUSE_VERSION=24.8
NEO4J_VERSION=5-community
# MinIO ücretli değildir (AGPL-3.0). Ancak 2025'te community konsolundaki
# YÖNETİM özellikleri ticari sürüme taşındı; bu sürüm bilerek o değişiklikten
# önceye sabitlendi ki paneldeki MinIO Console tam çalışsın. bkz. docs/LICENSING.md
MINIO_VERSION=RELEASE.2024-10-13T13-34-11Z

# MongoDB 5.0 öncesinde `mongosh` yoktur; MONGO_VERSION=4.4 kullanıyorsanız:
#   MONGO_SHELL=mongo
MONGO_SHELL=mongosh


# ─── İMAJ DEĞİŞTİRME (opsiyonel) ──────────────────────────────────────────────
# Her motorun imajı tamamen değiştirilebilir. Üç kullanım:
#   1) Lisans alternatifi — ör. Redis yerine BSD-3 lisanslı Valkey (birebir uyumlu):
#        REDIS_IMAGE=valkey/valkey:8-alpine
#   2) Kapalı ağda kendi registry aynanız:
#        MARIADB_IMAGE=registry.sirket.local/mariadb:11.4
#   3) Kurum içi sertleştirilmiş imaj
# Lisans ayrıntıları ve alternatifler: docs/LICENSING.md  (./stack.sh licenses)
# MARIADB_IMAGE=
# POSTGRES_IMAGE=
# MONGO_IMAGE=
# REDIS_IMAGE=
# MSSQL_IMAGE=
# CASSANDRA_IMAGE=
# ELASTIC_IMAGE=
# KAFKA_IMAGE=
# RABBITMQ_IMAGE=
# CLICKHOUSE_IMAGE=
# NEO4J_IMAGE=
# MINIO_IMAGE=

# ─── AĞ / PORTLAR ─────────────────────────────────────────────────────────────
# Gateway'in HTTP (yalnız yönlendirme + CA indirme) ve HTTPS portları.
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# Veritabanı istemci portları. Panel portları (8081-8091) sabittir.
MARIADB_PORT=3306
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379
MSSQL_PORT=1433
CASSANDRA_PORT=9042
ELASTIC_PORT=9200
KAFKA_PORT=9092
RABBITMQ_PORT=5672
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
NEO4J_BOLT_PORT=7687
# 9000 ClickHouse'un native portu ile çakışmasın diye MinIO S3 API'si 9002'de.
MINIO_API_PORT=9002

DEFAULT_DATABASE=defaultdb


# ─── YEDEKLEME ────────────────────────────────────────────────────────────────
# Yedek ve log dizinleri (varsayılan: ${STACK_DIR}/backups ve /logs)
# BACKUP_DIR=/mnt/backups
# LOG_DIR=/var/log/databases

# Yerel saklama süresi (gün)
RETENTION_DAYS=7
# gzip seviyesi (1=hızlı … 9=en iyi; günlük yedek için 6 dengeli)
COMPRESSION_LEVEL=6
# MariaDB dump'ından hariç tutulacak tablolar (SQL LIKE, boşlukla ayrılır).
# Varsayılan: Laravel Telescope/Pulse. Devre dışı bırakmak için boş bırakın.
BACKUP_EXCLUDE_TABLE_PATTERNS=telescope% pulse%


# ─── GOOGLE DRIVE SYNC (opsiyonel) ────────────────────────────────────────────
REMOTE_SYNC_ENABLED=false
RCLONE_REMOTE_NAME=gdrive
GDRIVE_FOLDER=Database Backups
RETENTION_REMOTE_DAYS=30


# ─── OTOMATİK DEVİR (FAILOVER) ────────────────────────────────────────────────
# Hangi motorlarda açık olduğu dashboard'dan yönetilir (state/state.json).
# Aşağıdakiler denetleyicinin davranışını ayarlar:
# Primary'ye kaç saniyede bir bakılsın
FAILOVER_INTERVAL=10
# Üst üste kaç başarısız kontrolden sonra devir yapılsın.
# Tek bir başarısız kontrol geçici olabilir (anlık yük, GC duraklaması);
# gereksiz devir gereksiz kesinti demektir.
FAILOVER_STRIKES=3
# İki devir arasında beklenecek en az süre (döngüye girmeyi önler)
FAILOVER_COOLDOWN=300

# ─── BİLDİRİM (opsiyonel) ─────────────────────────────────────────────────────
# Devir, yedekleme hatası gibi kritik olaylar buraya POST edilir.
# Slack / Teams / Discord webhook adresi ya da kendi ucunuz.
NOTIFY_WEBHOOK=

# ─── REPLİKASYON (dashboard'dan yönetilir, elle doldurmanız gerekmez) ─────────
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_SLOT=replica_1
MONGO_REPLICA_SET=rs0
