    {
      "id": 7,
      "type": "timeseries",
      "title": "Saniyedeki Dosya İşlemi (türe göre)",
      "description": "MinIO'ya saniyede kaç dosya isteği geldiğini türüne göre gösterir: putobject = dosya yükleme, getobject = dosya indirme, listobjectsv2 = klasör listeleme, headobject = dosya var mı sorgusu. Bu grafik \"sistem ne kadar yükleniyor?\" sorusunun cevabıdır. Yüksek olması tek başına kötü değildir; asıl dikkat edilecek şey, bu çizgiler artarken yandaki hata grafiğinin de yükselmesidir — o zaman MinIO yükün altında kalıyor demektir. Hiç işlem yoksa grafik boş görünür, bu normaldir.",
      "datasource": { "type": "prometheus", "uid": "dbstack-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "noValue": "Veri yok",
          "unit": "reqps",
          "mappings": [],
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "istek/sn",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "dbstack-prometheus" },
          "editorMode": "code",
          "expr": "sum by (api) (rate(minio_s3_requests_total{engine=\"minio\"}[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{api}}",
          "refId": "A"
        }
      ],
