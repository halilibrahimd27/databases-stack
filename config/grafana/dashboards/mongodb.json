          "range": false,
          "legendFormat": "Durum"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Açık Bağlantı",
      "description": "Şu anda MongoDB'ye bağlı olan uygulama/oturum sayısı. Normalde belli bir aralıkta gezinir. Sürekli tırmanıyor ve hiç düşmüyorsa uygulama açtığı bağlantıları kapatmıyor olabilir. Bu sayının kendisi tek başına bir şey söylemez; asıl karar verilecek yer yandaki 'Bağlantı Doluluğu' kutusudur.",
      "datasource": { "type": "prometheus", "uid": "dbstack-prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "pluginVersion": "11.0.0",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Veri yok",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
