  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Erişilebilir mi?",
      "description": "MongoDB'nin izleme sistemine cevap verip vermediğini gösterir. 'Çalışıyor' yazıyorsa sorun yok. 'Erişilemiyor' yazıyorsa motor ya kapalıdır ya da çökmüştür; bu durumda panodaki diğer grafikler de boşalır. Motoru açtığınız halde burası kırmızıysa kayıtlara bakın: ./stack.sh logs mongodb",
      "datasource": { "type": "prometheus", "uid": "dbstack-prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "pluginVersion": "11.0.0",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Veri yok",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Erişilemiyor", "color": "red", "index": 0 },
                "1": { "text": "Çalışıyor", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
