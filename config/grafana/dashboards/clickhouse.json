  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Erişilebilirlik",
      "description": "ClickHouse ayakta mı? Bu kutunun cevabı doğrudan ClickHouse'un kendi metrik ucundan gelir; araya ayrı bir exporter girmez, yani 'Çalışıyor' yazıyorsa 30 saniyede bir sorulan yoklamaya motorun kendisi cevap vermiştir. 'Cevap vermiyor' yazıyorsa motor ya kapalı ya da takılmış durumdadır; uygulamalarınız bağlanamaz, hata alır. Motoru siz kapattıysanız kutu 'Veri yok' gösterir, bu normaldir.",
      "datasource": {
        "type": "prometheus",
        "uid": "dbstack-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Veri yok",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Cevap vermiyor",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Çalışıyor",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dbstack-prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=\"databases\", engine=\"clickhouse\"}",
          "legendFormat": "Durum",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Açık bağlantı sayısı",
      "description": "Şu anda ClickHouse'a bağlı istemci sayısı (HTTP arayüzü ve native protokol birlikte). Normalde uygulamanızın bağlantı havuzu kadar olur ve dalgalanır. Bu kurulumda üst sınır 4096 bağlantıdır; kutu 1000'de sarıya, 2000'de kırmızıya döner — yani sınıra varmadan çok önce uyarır. Asıl bakılacak şey şudur: sayı sürekli tırmanıp hiç düşmüyorsa uygulama açtığı bağlantıları kapatmıyordur (bağlantı sızıntısı). Sınıra ulaşıldığında sunucu yeni bağlantı kabul etmez ve uygulama 'bağlanamadı' hatası verir.",
      "datasource": {
        "type": "prometheus",
        "uid": "dbstack-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "Veri yok",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
