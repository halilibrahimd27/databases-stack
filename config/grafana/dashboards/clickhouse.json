    {
      "id": 4,
      "type": "stat",
      "title": "Bellek doluluğu",
      "description": "ClickHouse'un kullandığı belleğin, bu konteynere ayrılan belleğe oranı (konteynere limit konmamışsa sunucunun toplam RAM'ine oranı). ClickHouse sorgu sırasında belleği bolca kullanır, sayının inip çıkması normaldir. Motorun kendi tavanı ayrılan belleğin yaklaşık dörtte üçüne kurulur: oraya dayanan büyük sorgular 'bellek sınırı aşıldı' hatasıyla iptal edilir — sunucu çökmez ama sorgu tamamlanmaz. Yüzde 80'i sürekli aşıyorsa ya sorguları küçültün (daha az satır, daha az sütun) ya da motora daha çok bellek verin: motoru kapatıp yeniden açtığınızda yığın belleği baştan hesaplar.",
      "datasource": {
        "type": "prometheus",
        "uid": "dbstack-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "noValue": "Veri yok",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dbstack-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * ClickHouseMetrics_MemoryTracking{engine=\"clickhouse\"}\n/\nclamp_max(\n  ClickHouseAsyncMetrics_CGroupMemoryTotal{engine=\"clickhouse\"},\n  scalar(ClickHouseAsyncMetrics_OSMemoryTotal{engine=\"clickhouse\"})\n)",
          "legendFormat": "Bellek doluluğu",
          "range": true
        }
      ]
    },
