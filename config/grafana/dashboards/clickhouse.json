          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dbstack-prometheus"
          },
          "editorMode": "code",
          "expr": "sum({__name__=~\"ClickHouseMetrics_(TCP|HTTP)Connection\", engine=\"clickhouse\"})",
          "legendFormat": "Bağlantı",
