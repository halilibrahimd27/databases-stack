              { "color": "text", "value": null },
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
