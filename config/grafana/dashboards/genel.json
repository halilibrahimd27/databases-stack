  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cevap vermeyen bileşen sayısı",
      "description": "İzlenen bileşenlerden kaç tanesi şu an cevap vermiyor. 0 ise her şey ayakta, yapacak bir şey yok. 1 ya da daha fazlaysa o motoru kullanan uygulamalar hata almaya başlar: hangisi olduğunu aşağıdaki tablodan görün, sonra kayıtlara bakın (./stack.sh logs <motor>). Kapattığınız motorlar burada sayılmaz — kapalı olmak arıza değildir.",
      "datasource": { "type": "prometheus", "uid": "dbstack-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Yok — hepsi çalışıyor", "color": "green", "index": 0 }
              }
            }
          ],
          "noValue": "Veri yok",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "dbstack-prometheus" },
          "editorMode": "code",
          "expr": "count(up{job=\"databases\"} == 0) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "Cevap vermeyen",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sunucunun RAM doluluğu",
      "description": "Sunucudaki toplam belleğin yüzde kaçı kullanılıyor. %75'in altı rahat. %90'ı geçtiyse sunucu darda demektir: yeni motor açmayın, açık motorlardan birini kapatmayı ya da sunucuya RAM eklemeyi düşünün. Bellek tamamen dolarsa işletim sistemi süreçleri kendiliğinden öldürmeye başlar ve veritabanları habersiz kapanabilir.",
      "datasource": { "type": "prometheus", "uid": "dbstack-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "Veri yok",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "dbstack-prometheus" },
          "editorMode": "code",
          "expr": "100 * (1 - avg(node_memory_MemAvailable_bytes) / avg(node_memory_MemTotal_bytes))",
          "instant": false,
          "range": true,
          "legendFormat": "Kullanılan",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
