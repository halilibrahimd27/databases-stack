  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cevap vermeyen bileşen sayısı",
      "description": "İzlemenin ulaşmaya çalıştığı adreslerden kaç tanesi şu an cevap vermiyor. Sayıya veritabanı ölçerleri kadar izlemenin kendisi de dahildir (Prometheus, sunucu ölçeri, denetleyici) — böylece izleme çökerse kutu bunu 'her şey yolunda' diye yutmaz. 0 ise yapacak bir şey yok. 1 ya da daha fazlaysa hangisi olduğunu yandaki tablodan görün, sonra kayıtlara bakın: ./stack.sh logs <motor>. Kapattığınız motorlar burada sayılmaz — kapalı olmak arıza değildir. Kutu turuncu zeminde 'İzleme hedefi yok' diyorsa arıza sayısı sıfır olduğu için değil, izleme hiçbir hedefe ulaşamadığı için boştur; bu da bir arızadır ve 0 ile aynı şey değildir.",
      "datasource": {
        "type": "prometheus",
        "uid": "dbstack-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Yok — hepsi çalışıyor",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "noValue": "İzleme hedefi yok",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dbstack-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(up{job=~\"databases|host|controller|prometheus\"} == bool 0)",
          "instant": true,
          "range": false,
          "legendFormat": "Cevap vermeyen",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sunucunun RAM doluluğu",
      "description": "Sunucudaki toplam belleğin yüzde kaçı kullanılıyor. %75'in altı rahat. %90'ı geçtiyse sunucu darda demektir: yeni motor açmayın, açık motorlardan birini kapatmayı ya da sunucuya RAM eklemeyi düşünün. Bellek tamamen dolarsa işletim sistemi süreçleri kendiliğinden öldürmeye başlar ve veritabanları habersiz kapanabilir. Bu kutunun verisi sunucu ölçerinden (node-exporter) gelir; izleme profili kapalıysa ya da o bileşen ayakta değilse kutu boş kalır — panel bozuk değildir, önce yandaki tabloya bakın.",
      "datasource": {
        "type": "prometheus",
        "uid": "dbstack-prometheus"
