          "datasource": { "type": "prometheus", "uid": "dbstack-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(elasticsearch_indices_search_query_total{engine=\"elasticsearch\"}[5m]))",
          "instant": false,
          "legendFormat": "Arama (sorgu) / sn",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "dbstack-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(elasticsearch_indices_indexing_index_total{engine=\"elasticsearch\"}[5m]))",
          "instant": false,
          "legendFormat": "Kayıt yazma / sn",
