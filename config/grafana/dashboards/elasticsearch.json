    {
      "id": 7,
      "type": "timeseries",
      "title": "Saniyedeki arama ve kayıt işlemi",
      "description": "Elasticsearch'ün saniyede kaç arama yaptığı ve kaç yeni kayıt yazdığı — yani üzerindeki iş yükü. Gün içinde inip çıkması normaldir; iş saatlerinde yükselip gece düşmesi beklenir. Hiçbir uygulama kullanılmadığı halde çizgi sürekli yüksekse beklenmedik bir kaynak veri yazıyor olabilir. Bu grafik yükselirken \"Ortalama arama süresi\" de uzuyorsa motor gelen yüke yetişemiyor demektir.",
      "datasource": { "type": "prometheus", "uid": "dbstack-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "pluginVersion": "11.0.0",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops",
          "min": 0,
          "decimals": 2,
          "mappings": [],
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "işlem/sn",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
