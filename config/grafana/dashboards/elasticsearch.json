      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "dbstack-prometheus" },
          "editorMode": "code",
          "expr": "100 * sum(rate(elasticsearch_indices_query_cache_count{engine=\"elasticsearch\"}[5m])) / (sum(rate(elasticsearch_indices_query_cache_count{engine=\"elasticsearch\"}[5m])) + sum(rate(elasticsearch_indices_query_miss_count{engine=\"elasticsearch\"}[5m])))",
          "instant": false,
          "legendFormat": "Hafızadan karşılanan arama oranı",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
