  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Redis çalışıyor mu?",
      "description": "Redis'e bağlanılabiliyor mu, onu söyler. \"Çalışıyor\" yazıyorsa sorun yok. \"Erişilemiyor\" yazıyorsa Redis ayakta değil ya da parola/ağ yüzünden bağlanılamıyor: Redis'i kullanan uygulamalar veri bulamaz, sayfalar yavaşlar ya da hata verir — kayıtlara bakın: ./stack.sh logs redis. \"Bilgi yok\" yazıyorsa ölçüm hiç gelmiyordur; genellikle Redis profili tamamen kapalıdır (ölçüm toplayıcı da Redis ile birlikte durur). Bu kutu her zaman ANLIK durumu gösterir, motor kapandıktan sonra eski değeri ekranda tutmaz.",
      "datasource": {
        "type": "prometheus",
        "uid": "dbstack-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Erişilemiyor",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Çalışıyor",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "Bilgi yok",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
