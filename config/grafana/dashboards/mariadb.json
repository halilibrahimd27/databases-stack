    {
      "id": 4,
      "type": "stat",
      "title": "Bellekteki Veri",
      "description": "MariaDB'nin, diske gitmeden okuyabilmek için RAM'de tuttuğu veri miktarı (InnoDB tampon havuzu). Bu sayının zamanla artıp ayrılan alanın tamamına yaklaşması NORMALDİR ve sorun değildir; veritabanı 'ısınıyor', yani sık kullanılan veriyi belleğe alıyor demektir. Boş kalması ise veritabanının yeni açıldığını ya da hiç kullanılmadığını gösterir. Asıl bakılması gereken yer aşağıdaki 'Önbellek İsabet Oranı' grafiğidir.",
      "datasource": {
        "type": "prometheus",
        "uid": "dbstack-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Veri yok",
          "unit": "decbytes",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dbstack-prometheus"
          },
          "editorMode": "code",
          "expr": "mysql_global_status_innodb_buffer_pool_bytes_data{engine=\"mariadb\"}",
          "legendFormat": "Bellekteki veri",
          "range": true,
          "instant": false
        }
      ]
    },
    {
