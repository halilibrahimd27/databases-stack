# =============================================================================
# MariaDB — statik ayarlar
# =============================================================================
# BELLEKLE ÖLÇEKLENEN ÜÇ AYAR BURADA DEĞİLDİR:
#   innodb_buffer_pool_size · innodb_log_file_size · max_connections
# Bunları controller sunucunun RAM'ine göre hesaplar ve compose `command:`
# satırıyla geçer (komut satırı argümanı config dosyasını ezer). Buraya elle
# yazarsanız yok sayılırlar — değiştirmek isterseniz catalog.json'daki
# resources.tuning kurallarını düzenleyin.
# =============================================================================

[client]
port   = 3306
# NOT: socket yolu bilerek TANIMSIZ — resmi imajın kendi yolunu kullanır
# (/run/mysqld/mysqld.sock). Eskiden /tmp/mysql.sock'a zorlanıyordu; imajın
# entrypoint'i ve healthcheck.sh farklı yola baktığı için kırılgandı.

[mysqld]
port                   = 3306
datadir                = /var/lib/mysql
default_storage_engine = InnoDB
skip-external-locking

character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
sql-mode             = NO_ENGINE_SUBSTITUTION,STRICT_TRANS_TABLES

# --- Bağlantı başına buffer'lar ----------------------------------------------
# Bunlar HER BAĞLANTI İÇİN ayrı ayrı ayrılır. max_connections ile çarpılır:
# 8M sort + 8M read × 1000 bağlantı = 16 GB. Bu, geçmişte container'ı
# CONSTRAINT_MEMCG OOM'a sokan hatanın ta kendisiydi — küçük tutulmaları şart.
sort_buffer_size     = 1M
join_buffer_size     = 256K
read_buffer_size     = 128K
read_rnd_buffer_size = 256K
net_buffer_length    = 4K

# --- Global buffer'lar --------------------------------------------------------
key_buffer_size        = 64M     # yalnız MyISAM içindir; InnoDB kullanıyoruz
table_open_cache       = 4000
table_definition_cache = 2000
thread_cache_size      = 64
tmp_table_size         = 32M
max_heap_table_size    = 32M

# Query cache KAPALI. MariaDB'de tek global mutex'e bağlıdır; yüksek bağlantı
# sayısında hızlandırmak yerine yavaşlatır ve 10.1'den beri varsayılanı OFF'tur.
# (Eskiden 256M ayrılıyordu — boşa duran bellek + kilit çekişmesi.)
query_cache_type = 0
query_cache_size = 0

# 100G yazılmıştı; MariaDB'nin üst sınırı 1G olduğu için sessizce kırpılıyordu.
max_allowed_packet = 256M

max_connect_errors = 100
open_files_limit   = 65535
wait_timeout       = 900
interactive_timeout = 900
#skip-name-resolve   # istemcileri IP ile tanımlıyorsanız açın (DNS beklemesini keser)

# --- Binlog: PITR + replikasyon ----------------------------------------------
# AÇIK. İki nedenle: (1) dashboard'dan "replika kur" diyebilmek için şart,
# (2) günlük yedekler arasındaki kaybı (24 saate kadar) point-in-time recovery
# ile kapatır. Diski doldurmaması için 7 günde bir temizlenir.
server-id                   = 1
log_bin                     = mysql-bin
binlog_format               = ROW
binlog_expire_logs_seconds  = 604800
gtid_strict_mode            = ON
sync_binlog                 = 0

# --- InnoDB -------------------------------------------------------------------
innodb_data_home_dir      = /var/lib/mysql
innodb_data_file_path     = ibdata1:10M:autoextend
innodb_log_group_home_dir = /var/lib/mysql
innodb_log_buffer_size    = 64M    # 256M idi; varsayılanın 16 katı, boşa duruyordu
# 2 = saniyede bir diske flush. Çökmede en fazla 1 sn'lik işlem kaybı riski var,
# karşılığında I/O baskısı belirgin düşer. Katı ACID gerekiyorsa 1 yapın.
innodb_flush_log_at_trx_commit = 2
innodb_lock_wait_timeout    = 50
innodb_max_dirty_pages_pct  = 90
innodb_read_io_threads      = 8
innodb_write_io_threads     = 8
innodb_file_per_table       = ON

# --- Yavaş sorgu günlüğü ------------------------------------------------------
slow_query_log      = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time     = 2

[mariadb-dump]
quick
max_allowed_packet = 256M
single-transaction
routines
triggers
events
# complete-insert BİLEREK YOK: dump boyutunu ~2 katına çıkarıyor, karşılığında
# yalnız sütun adlarını yazıyor. Yedekleme betiği gerekli bayrakları kendi verir.

[mysql]
no-auto-rehash
