# =============================================================================
# databases-stack gateway — tek giriş kapısı
# =============================================================================
# Bu dosya nginx imajının envsubst adımından geçer (/etc/nginx/templates/*.template
# → /etc/nginx/conf.d/*.conf). NGINX_ENVSUBST_FILTER="^STACK_" olduğu için
# YALNIZCA ${STACK_...} değişkenleri değiştirilir; $host, $uri gibi nginx
# değişkenleri olduğu gibi kalır.
#
# ⚙️ EN KRİTİK NOKTA — DEĞİŞKENLİ proxy_pass:
# Her upstream `set $up_x ...;` ile bir DEĞİŞKENE atanır. nginx, proxy_pass'te
# değişken görürse DNS çözümünü açılış anında değil İSTEK anında yapar.
# Sabit yazsaydık, kapalı bir motorun container'ı olmadığı için nginx
# "host not found in upstream" ile hiç açılmaz ve tüm dashboard çökerdi —
# yani aktif et/pasif et modeli imkânsız olurdu. Böyle olunca kapalı motor
# sadece 502 döner, biz de onu "pasif" sayfasına çeviriyoruz.
# =============================================================================

# DNS sunucusu. Docker'da gömülü resolver (127.0.0.11), Kubernetes'te kube-dns
# (10.96.0.10) olur — bu yüzden değişkenle geliyor, aynı yapılandırma iki
# ortamda da çalışsın diye. valid=10s → motor aktif edilince en geç 10 sn'de görülür.
resolver ${STACK_RESOLVER} valid=10s ipv6=off;
resolver_timeout 5s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# -----------------------------------------------------------------------------
# ÇAPRAZ-SİTE (CSRF) KONTROLÜ — (1) yalnız /api/, (2) ikisinde de,
#                               (3)+(4) yalnız panel portları
# -----------------------------------------------------------------------------
# Buradaki açık şuydu: kimlik doğrulaması Basic auth ile yapılıyor ve tarayıcı,
# panele bir kez girildikten sonra o kimlik bilgisini bu adrese giden HER
# isteğe kendiliğinden ekliyor — isteği başlatan sayfa hangi siteye ait olursa
# olsun (SameSite kuralları çerezler içindir, HTTP auth'a işlemez). Ayrıcalıklı
# X-Api-Token'ı da aşağıda gateway'in kendisi ekliyor. Yani kötü niyetli bir
# sayfanın token'ı bilmesine gerek yoktu: yönetici o sekmeyi açtığı anda gizli
# bir form POST'u /api/engines/<motor>/deactivate ile bütün veritabanlarını
# kapatabilir, rebuild-standby ile replika diskini sildirebilirdi.
#
# İsteği kimin başlattığını iki başlıktan anlıyoruz. İkisini de sayfadaki
# JavaScript DEĞİŞTİREMEZ; tarayıcı doldurur (yasaklı başlıklar).

# 1) Sec-Fetch-Site — güncel tarayıcıların hepsi gönderir.
map $http_sec_fetch_site $csrf_site_ok {
    default         0;   # cross-site / same-site → isteği BAŞKA bir sayfa başlatmış
    ''              1;   # başlık yok: tarayıcı değil (curl, betik) ya da çok eski tarayıcı
    "same-origin"   1;   # panelin kendi sayfası
    "none"          1;   # adres çubuğuna yazılmış ya da yer iminden açılmış
}

# 2) Origin — Sec-Fetch-* göndermeyen eski tarayıcılar bile çapraz-site
#    POST'ta bunu gönderir. Yalnız adres kısmını alıyoruz: panel 443 yerine
#    başka bir porta bağlanmış olabilir (GATEWAY_HTTPS_PORT), o yüzden port
#    karşılaştırmaya girmiyor. Origin yoksa karşılaştırma bilerek geçilir
#    (curl ile /api/ çağıran bakım betikleri çalışmaya devam etsin).
map $http_origin $csrf_origin_host {
    default                       $http_origin;   # tanımadığımız biçim → eşleşmez, reddedilir
    ''                            $host;
    "~^https?://(.+?)(:[0-9]+)?$" $1;
}

# 3) İsteğin YÖNTEMİ — panel portlarında (4) ile BİRLİKTE kullanılır.
#    TEK BAŞINA ölçüt olamaz; nedeni hemen aşağıda yazıyor.
map $request_method $panel_write {
    default 1;   # POST/PUT/DELETE/PATCH → veriyi değiştirebilir
    GET     0;
    HEAD    0;
    OPTIONS 0;
}

# 4) İSTEĞİ NE BAŞLATTI — panel portlarındaki asıl kapı
#    (kullanan yer: snippets/panel-csrf.conf, her panel location'ında)
#
# ÖNCEKİ HALİ NEDEN YETMEDİ: kapı yalnızca yukarıdaki $panel_write'a, yani HTTP
# yöntemine bakıyordu. ÖLÇTÜĞÜ şey "yöntem POST mu?", CEVAP VERDİĞİNİ SANDIĞI
# soru ise "bu istek veriyi değiştirebilir mi?"ydi. İkisi eşit değil: eski web
# arayüzleri yıkıcı işlemleri GET ile sunar. mongo-express 1.0.2'de:
#     GET /db/<vt>/dropIndex/<koleksiyon>?name=...  → indeksi SİLER
#     GET /db/<vt>/compact/<koleksiyon>             → koleksiyonu sıkıştırır
#     GET /db/<vt>/reIndex/<koleksiyon>             → indeksleri yeniden kurar
# Kötü niyetli bir sayfadaki tek bir <img src="https://<ip>:8083/db/app/
# dropIndex/users?name=email_1"> etiketi, yöntemi GET olduğu için eski kapıdan
# geçiyordu; tarayıcı da o panele girmiş yöneticinin kimlik bilgisini isteğe
# kendisi ekliyordu. Canlı container'da üretildi: indeks gerçekten düştü.
#
# BİLİNEN ÜÇ YOLU KARA LİSTEYE ALMADIK. Bu bir mongo-express arızası değil, bir
# SINIF: panel imajı yükselince yollar değişir, başka panelde başka bir GET ucu
# çıkar (ClickHouse'un /?query=... ucu aynı aileden), liste sessizce eksik
# kalır — test yeşil, koruma yok. Üstelik gateway arkadaki panelin hangi
# ucunun ne yaptığını bilemez: "bu istek veriyi değiştirir mi?" BURADA
# cevaplanabilir bir soru değil.
#
# Cevaplanabilen soru şu: "BU İSTEĞİ PANELİN KENDİ SAYFASI MI BAŞLATTI?"
# Tarayıcı bunu Sec-Fetch-Site ve Sec-Fetch-Mode başlıklarıyla kendisi
# söylüyor; sayfadaki JavaScript ikisini de DEĞİŞTİREMEZ (yasaklı başlıklar).
# Yöntem ne olursa olsun, yol ne olursa olsun geçerli bir ölçüt.
#
# Üç kademe:
#   2 = güvenilir. Panelin kendi sayfası (same-origin), adres çubuğu/yer imi
#       (none) ya da tarayıcı olmayan istemci (başlık yok: curl, bakım betiği).
#       Panel içindeki HER ŞEY buraya düşer — bağlantılar, formlar, XHR,
#       resimler, WebSocket — çünkü panel sayfası da panelin portundan gelir.
#   1 = yalnız GİRİŞ GEZİNMESİ. Dashboard'daki "Panel aç" düğmesi panele ayrı
#       porttan gider (:443 → :8083) ve tarayıcı port farkı yüzünden buna
#       "same-site" der. Yalnızca üst seviye gezinme (navigate) sayılır: aynı
#       sitenin başka portundaki bir sayfanın gizli alt-kaynak isteği (resim,
#       XHR) SAYILMAZ. Bu kademede veri değiştiren yöntemlere izin verilmez.
#   0 = isteği başka bir sayfa başlatmış → geçmez. Kötü niyetli sayfanın
#       <img>/<iframe>/fetch isteği de, location.href ile yaptığı çapraz-site
#       gezinme de buraya düşer. İkincisi de gerçek bir yol: SameSite=Lax
#       çerez (panel tek oturumu) üst seviye gezinmede gönderilir.
#
# ÖDÜNLEŞİM, BİLEREK: başka bir sitedeki bağlantıya tıklayarak panele girmek
# artık çalışmaz; kullanıcı açıklama sayfasını görür. Panele giriş yolu
# dashboard, yer imi ya da adres çubuğudur — üçü de 1 veya 2 kademesinde.
#
# SINIR, AÇIKÇA: Sec-Fetch-* göndermeyen tarayıcılarda (Safari 16.4 öncesi) bu
# kapı devre dışı kalır; geriye Origin kontrolü kalır, o da POST'u yakalar ama
# <img> ile gönderilen GET'i yakalamaz. Başlığı zorunlu tutamayız — o zaman
# aynı tarayıcılar paneli hiç açamazdı. Referer'a da bakmıyoruz: saldırganın
# sayfası tek bir meta etiketiyle Referer'ı kapatabildiği için gerçek bir kapı
# değil, yalnızca yanlış bir güvenlik hissi olurdu.
map "$http_sec_fetch_site:$http_sec_fetch_mode" $panel_from {
    default              0;   # çapraz-site, ya da same-site alt-kaynak isteği
    ":"                  2;   # hiç Sec-Fetch-* yok → tarayıcı değil (curl, betik)
    "~^same-origin:"     2;   # panelin kendi sayfası
    "~^none:"            2;   # adres çubuğu, yer imi
    "same-site:navigate" 1;   # dashboard → panel geçişi
    "same-site:"         1;   # Site'ı gönderip Mode'u göndermeyen tarayıcı
}

# -----------------------------------------------------------------------------
# PANEL TEK OTURUMU — bir kez gir, bütün panellere geç
# -----------------------------------------------------------------------------
# Paneller ayrı portlarda; tarayıcı için her port AYRI ORIGIN olduğundan basic
# auth 443'ten 8081'e taşınmaz ve her panelde yeniden sorulur. Çerezler ise
# port değil HOST başına paylaşılır: dashboard'a girildiğinde bırakılan çerez
# (snippets/panel-sso.conf) panel portlarına da gider ve orada parola sorulmaz.
#
# GÜVENLİK: çerez taşımayan bir istek — yani dışarıdan doğrudan panele gelen
# biri — normal parola ekranıyla karşılaşır. Sahte çerez de eşleşmez.
#
# Ara değişkenin sebebi: $cookie_x, çerez YOKKEN de çerez BOŞKEN de "" döner.
# Eşleştirmeyi doğrudan yapsaydık ve .env'de sır tanımlı olmasaydı (eski
# kurulumlar) anahtar "" olurdu ve çerezsiz her istekle eşleşip BÜTÜN
# PANELLERİ parolasız açardı. Değeri önce sabit bir önekle sarmalayıp yokluğu
# ayrı bir işaretçiye çevirerek bu ihtimali imkânsız kılıyoruz.
# Sır, snippet'ten de erişilebilsin diye normal bir nginx değişkenine
# bağlanıyor. Snippet'ler envsubst'tan GEÇMEZ (nginx imajı yalnız
# /etc/nginx/templates/*.template dosyalarını işler); snippet içinde
# ${STACK_PANEL_SSO} yazsaydık nginx onu tanımsız bir değişken sayardı.
map $host $panel_sso_secret {
    default "${STACK_PANEL_SSO}";
}

map $cookie_dbstack_sso $panel_sso_val {
    default "cookie:$cookie_dbstack_sso";
    ""      "cookie:-cerez-yok-";
}
map $panel_sso_val $panel_auth {
    default                     "databases-stack paneli";
    "cookie:${STACK_PANEL_SSO}" off;
}


ssl_session_cache   shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# Güvenlik başlıkları — always ile hata sayfalarında da gönderilir.
add_header X-Frame-Options        "SAMEORIGIN"        always;
add_header X-Content-Type-Options "nosniff"           always;
add_header Referrer-Policy        "same-origin"       always;

client_max_body_size 512m;
server_tokens off;

# Proxy zaman aşımı varsayılanları. Buradan miras alınır; uzun süren uçlar
# (veri aktaran paneller, Kibana araması, motor aktivasyonu) kendi
# location'ında büyüğünü verir. Süre dolduğunda nginx 504 üretir; 504 artık
# "pasif" sayfasına DEĞİL, zaman aşımını anlatan ayrı bir sayfaya bağlı
# (bkz. snippets/proxy.conf) — ikisi aynı sayfaya bağlıyken çalışan bir
# motorda uzun süren import kullanıcıya "veritabanı kapalı" diye görünüyordu.
proxy_read_timeout  300s;
proxy_send_timeout  300s;
proxy_connect_timeout 10s;

# =============================================================================
# PORT 80 — yalnızca yönlendirme + CA sertifikası indirme
# =============================================================================
server {
    listen 80 default_server;
    server_name _;

    # Sağlık ucu: auth YOK (healthcheck ve monitoring buradan bakar).
    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "healthy\n";
    }

    # İç CA sertifikası. TLS uyarısını kaldırmak için istemciye kurulur —
    # bu yüzden HTTPS'ten ÖNCE, auth'suz ve düz HTTP üzerinden erişilebilir
    # olmalı (yoksa "sertifikaya güvenmek için sertifikaya güvenmen gerekir"
    # kısır döngüsü olur). Kamuya açık bir şey değildir: içinde yalnızca
    # ortak anahtar vardır, özel anahtar certs/ca.key'de kalır.
    location = /ca.crt {
        access_log off;
        alias /etc/nginx/certs/ca.crt;
        add_header Content-Type application/x-x509-ca-cert;
        add_header Content-Disposition 'attachment; filename="databases-stack-ca.crt"';
    }

    # Sertifika kurulum rehberi. auth YOK ve HTTPS'e yönlendirilmez: kullanıcı
    # tam da sertifikaya güvenmediği için buraya geliyor. Statik dosyalar
    # (style.css) da bu sunucudan servis edilmeli, yoksa sayfa çıplak görünür.
    location = /setup {
        root /usr/share/nginx/html;
        try_files /setup.html =404;
    }
    location ~ ^/(style\.css|setup\.html)$ {
        root /usr/share/nginx/html;
    }

    # KÖK: HTTPS'e YÖNLENDİRMİYORUZ — bilerek.
    # Kullanıcı tarayıcıya çıplak IP yazınca önce buraya (http) gelir. Buradan
    # https'e atarsak, sertifika henüz kurulu olmadığı için ilk karşılaştığı
    # şey Chrome'un "Bağlantınız gizli değil" korku ekranı olur.
    # Bunun yerine kurulum rehberini gösteriyoruz; o sayfa sertifikanın
    # kurulu olup olmadığını kendisi yoklayıp kuruluysa panele yönlendiriyor.
    location / {
        root /usr/share/nginx/html;
        try_files /setup.html =404;
    }
}

# =============================================================================
# PORT 443 — dashboard + kontrol API'si
# =============================================================================
server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;
    include /etc/nginx/snippets/ssl.conf;

    auth_basic           "databases-stack";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location = /health {
        auth_basic off;
        access_log off;
        add_header Content-Type text/plain;
        return 200 "healthy\n";
    }

    location = /ca.crt {
        auth_basic off;
        alias /etc/nginx/certs/ca.crt;
        add_header Content-Type application/x-x509-ca-cert;
        add_header Content-Disposition 'attachment; filename="databases-stack-ca.crt"';
    }

    # Kontrol düzlemi. Token'ı BURADA ekliyoruz: controller host'a port açmaz,
    # yani ona ancak bu satırdan geçilerek ulaşılabilir. Aynı docker ağındaki
    # başka bir container (ör. ele geçirilmiş bir panel) doğrudan denerse
    # token olmadığı için 401 alır.
    location /api/ {
        set $up_controller controller;

        # ÇAPRAZ-SİTE KONTROLÜ (bkz. dosyanın başındaki $csrf_* map'leri).
        # Yalnız BU location'da: /health ve /setup bilerek dışarıda kaldı —
        # kurulum rehberi onları düz http sayfasından, yani başka bir origin'den
        # çağırıyor ve buraya da uygulasaydık sertifika kurulumu kırılırdı.
        # Hata metni /_api_crosssite.txt'te (error_page ile, proxy-api.conf).
        if ($csrf_site_ok = 0)            { return 403; }
        if ($csrf_origin_host != "$host") { return 403; }

        include /etc/nginx/snippets/proxy-api.conf;
        proxy_set_header X-Api-Token "${STACK_CONTROLLER_TOKEN}";
        # Motor aktivasyonu imaj çekmeyi gerektirebilir; dakikalar sürebilir.
        proxy_read_timeout 1800s;
        proxy_pass http://$up_controller:8000;
    }

    # /api/ hata metinleri. Dashboard bu ucu fetch() ile çağırıyor ve hata
    # gövdesini kullanıcıya OLDUĞU GİBİ gösteriyor (app.js: r.text()); HTML
    # sayfası döndüğünde kullanıcı hata penceresinde koca bir HTML kaynağı
    # görüyordu. Bu yüzden düz metin, tek cümlelik ve ne yapılacağını söyleyen.
    # Hepsi `internal` — dışarıdan istenemez; auth_basic kapalı, yoksa hata
    # sayfası kullanıcıdan ikinci kez parola isterdi.
    location = /_api_crosssite.txt {
        internal;
        auth_basic off;
        default_type text/plain;
        charset      utf-8;
        return 403 "Bu istek panelin kendi sayfasından gelmediği için güvenlik gereği durduruldu. Hiçbir şey yapılmadı.

Bir işlem yapmak istiyorsanız panelin adresini tarayıcınızın adres çubuğuna kendiniz yazıp açın ve düğmeleri oradan kullanın.

Bu uyarıyı bir bağlantıya tıkladıktan sonra gördüyseniz, o sayfa sizin adınıza veritabanlarınıza komut göndermeye çalışmış olabilir.
";
    }
    location = /_api_down.txt {
        internal;
        auth_basic off;
        default_type text/plain;
        charset      utf-8;
        return 503 "Kontrol servisine şu anda ulaşılamıyor; büyük olasılıkla yeniden başlıyor. Veritabanlarınız bundan etkilenmez, yalnız buradaki düğmeler geçici olarak çalışmaz. Birkaç saniye sonra sayfayı yenileyip tekrar deneyin.
";
    }
    # DİKKAT — bu metin İKİ farklı duruma birden düşer. error_page /api/
    # location'ının tamamına bağlı, dashboard ise 5 saniyede bir /api/status,
    # /api/plans, /api/events çağırıyor; yani kullanıcı hiçbir düğmeye
    # basmadan da bu 504'ü görebilir. Eski metin "İşlem başlatıldı ama sonucu
    # beklerken süre doldu" diye başlıyordu: kendiliğinden yenilenen listede
    # bu, hiç yapılmamış bir işlemi haber veren yanlış bir cümleydi (app.js
    # başına kendi "Kontrol servisine ulaşılamıyor:" cümlesini de ekliyor).
    # Metin artık iki durumda da doğru: önce ne olduğunu söylüyor, uyarıyı
    # "işlem başlattıysanız" koşuluna bağlıyor.
    location = /_api_timeout.txt {
        internal;
        auth_basic off;
        default_type text/plain;
        charset      utf-8;
        return 504 "Kontrol servisi bu isteğe zamanında cevap vermedi. Veritabanlarınız bundan etkilenmez.

Az önce bir işlem başlattıysanız (aktif etme, kapatma, replika kurma) o işlem sunucuda sürüyor olabilir: aynı işlemi tekrar başlatmayın. Liste birkaç saniyede bir kendini yeniliyor, sonucu orada göreceksiniz.
";
    }

    # Motor kataloğu. Dashboard normalde /api/catalog'u kullanır; controller
    # kapalıysa buraya düşer ve en azından motor listesini gösterebilir.
    location = /catalog.json {
        alias /etc/nginx/catalog.json;
        default_type application/json;
    }

    # Sertifika rehberi HTTPS tarafında da auth'suz olsun: kullanıcı uyarıyı
    # geçip girdiyse bile buraya yönlendirebilelim.
    location = /setup {
        auth_basic off;
        root /usr/share/nginx/html;
        try_files /setup.html =404;
    }

    # Yedekler sayfası — panelin ikinci ekranı. /setup ile aynı desen:
    # temiz bir adres, arkasında tek bir dosya. try_files şart, çünkü
    # /yedekler diye bir DOSYA yok; `location /` yalnız $uri'ye baktığı
    # için adres çubuğuna yazılan /yedekler 404 dönerdi.
    #
    # /setup'tan tek farkı var ve bilerek: burada `auth_basic off` YOK.
    # Sertifika rehberi parolasızdır çünkü kullanıcı tam da sertifikaya
    # güvenmediği için oraya gelir. Bu sayfa ise diskteki yedek dosyalarının
    # adını, boyutunu ve tarihini listeler ve üstüne geri yükleme
    # başlatabilir — yani veriyi silip yerine koyan bir işlemin düğmesi.
    # Sunucu bloğundaki auth_basic buraya olduğu gibi miras kalıyor;
    # hiçbir şeyi kapatmıyoruz.
    #
    # panel-sso.conf `location /` ile aynı sebeple burada da: kullanıcı
    # panele /yedekler'i yer iminden ya da adres çubuğundan açarak da
    # girebilir, tek oturum çerezi ise yalnız girilen sayfada bırakılıyor.
    # Snippet üç güvenlik başlığını KENDİ İÇİNDE tekrarlıyor (add_header
    # mirası "hep ya da hiç"tir — bir add_header yazan blok üsttekilerin
    # hepsini yitirir), o yüzden buraya ayrıca add_header yazmıyoruz;
    # yazsaydık Set-Cookie ile birlikte gelen o üç başlığı düşürürdük.
    location = /yedekler {
        root /usr/share/nginx/html;
        try_files /yedekler.html =404;
        include /etc/nginx/snippets/panel-sso.conf;
    }

    location / {
        root  /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
        # Panel tek oturumu: buraya yalnız parola doğruysa gelinir.
        include /etc/nginx/snippets/panel-sso.conf;
    }

    include /etc/nginx/snippets/inactive.conf;
}

# =============================================================================
# PANELLER — her biri kendi HTTPS portunda
# =============================================================================
# Alt yol (/pma/ gibi) yerine ayrı port kullanıldı: phpMyAdmin, pgAdmin, Kibana,
# Neo4j Browser gibi araçların alt-yolda çalışması ayrı ayrı base-path ayarı
# ister ve kırılgandır. Ayrı portta her uygulama kendi kökünde çalışır.
# Panellerin KENDİ portları host'a açılmaz; tek yol buradan geçer.

# --- 8081 phpMyAdmin (MariaDB) ----------------------------------------------
server {
    listen 8081 ssl; http2 on; server_name _;
    include /etc/nginx/snippets/ssl.conf;
    auth_basic $panel_auth; auth_basic_user_file /etc/nginx/.htpasswd;
    location / {
        set $up phpmyadmin;
        include /etc/nginx/snippets/panel-csrf.conf;
        include /etc/nginx/snippets/proxy-panel.conf;
        # Import/export panelidir: 400 MB'lık bir dump'ın çalışması dakikalar
        # sürer ve o sürede panel tek bayt bile göndermez. Varsayılan 300s ile
        # nginx 5. dakikada bağlantıyı kesiyor, kullanıcı işlemin durduğunu
        # sanıyordu — oysa import sunucuda devam ediyordu.
        #
        # ÖDÜNLEŞİM, BİLEREK: bu süre `location /` seviyesinde, yani panelin
        # HER isteğini kapsıyor. Bedeli şu: arka ucu gerçekten takılmış bir
        # panelde (cevap vermeyen MariaDB'ye bağlanmaya çalışan phpMyAdmin)
        # kullanıcı 5 dakika sonra "işlem uzun sürdü" sayfasını değil, 1 saat
        # boyunca dönen tekerleği görür.
        # Daraltmayı iki yoldan da denedik, ikisi de daha kötü:
        #   • Yola göre (`location ~ ^/(import|export)\.php$`): phpMyAdmin 5.2
        #     imajında öyle dosyalar YOK — kökte yalnız index.php var, import
        #     index.php?route=/import ile çalışıyor. Yani kural hiçbir import'a
        #     uymaz, süre sessizce 300s'ye düşer ve yukarıdaki arıza geri gelir.
        #   • Yönteme göre (yalnız POST uzun olsun): proxy_read_timeout değişken
        #     kabul etmez, `if` içinde de yazılamaz; ayrıca Adminer'de uzun
        #     süren SELECT'ler GET ile gider — GET'i kısaltmak onları keserdi.
        # Sık karşılaşılan "motor kapalı" hali zaten hızlı biter: container yok
        # → bağlantı 10 saniyede reddedilir (proxy_connect_timeout) → "pasif"
        # sayfası. 1 saatlik sessizlik yalnız "bağlantı kuruldu ama cevap hiç
        # gelmiyor" durumunda görülür.
        proxy_read_timeout 3600s;
        proxy_pass http://$up:80;
    }
    include /etc/nginx/snippets/panel-csrf-page.conf;
    include /etc/nginx/snippets/inactive.conf;
}

# --- 8082 pgAdmin (PostgreSQL) ----------------------------------------------
