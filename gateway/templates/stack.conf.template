# =============================================================================
# databases-stack gateway — tek giriş kapısı
# =============================================================================
# Bu dosya nginx imajının envsubst adımından geçer (/etc/nginx/templates/*.template
# → /etc/nginx/conf.d/*.conf). NGINX_ENVSUBST_FILTER="^STACK_" olduğu için
# YALNIZCA ${STACK_...} değişkenleri değiştirilir; $host, $uri gibi nginx
# değişkenleri olduğu gibi kalır.
#
# ⚙️ EN KRİTİK NOKTA — DEĞİŞKENLİ proxy_pass:
# Her upstream `set $up_x ...;` ile bir DEĞİŞKENE atanır. nginx, proxy_pass'te
# değişken görürse DNS çözümünü açılış anında değil İSTEK anında yapar.
# Sabit yazsaydık, kapalı bir motorun container'ı olmadığı için nginx
# "host not found in upstream" ile hiç açılmaz ve tüm dashboard çökerdi —
# yani aktif et/pasif et modeli imkânsız olurdu. Böyle olunca kapalı motor
# sadece 502 döner, biz de onu "pasif" sayfasına çeviriyoruz.
# =============================================================================

# DNS sunucusu. Docker'da gömülü resolver (127.0.0.11), Kubernetes'te kube-dns
# (10.96.0.10) olur — bu yüzden değişkenle geliyor, aynı yapılandırma iki
# ortamda da çalışsın diye. valid=10s → motor aktif edilince en geç 10 sn'de görülür.
resolver ${STACK_RESOLVER} valid=10s ipv6=off;
resolver_timeout 5s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

ssl_session_cache   shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# Güvenlik başlıkları — always ile hata sayfalarında da gönderilir.
add_header X-Frame-Options        "SAMEORIGIN"        always;
add_header X-Content-Type-Options "nosniff"           always;
add_header Referrer-Policy        "same-origin"       always;

client_max_body_size 512m;
server_tokens off;

# =============================================================================
# PORT 80 — yalnızca yönlendirme + CA sertifikası indirme
# =============================================================================
server {
    listen 80 default_server;
    server_name _;

    # Sağlık ucu: auth YOK (healthcheck ve monitoring buradan bakar).
    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "healthy\n";
    }

    # İç CA sertifikası. TLS uyarısını kaldırmak için istemciye kurulur —
    # bu yüzden HTTPS'ten ÖNCE, auth'suz ve düz HTTP üzerinden erişilebilir
    # olmalı (yoksa "sertifikaya güvenmek için sertifikaya güvenmen gerekir"
    # kısır döngüsü olur). Kamuya açık bir şey değildir: içinde yalnızca
    # ortak anahtar vardır, özel anahtar certs/ca.key'de kalır.
    location = /ca.crt {
        access_log off;
        alias /etc/nginx/certs/ca.crt;
        add_header Content-Type application/x-x509-ca-cert;
        add_header Content-Disposition 'attachment; filename="databases-stack-ca.crt"';
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# =============================================================================
# PORT 443 — dashboard + kontrol API'si
# =============================================================================
server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;
    include /etc/nginx/snippets/ssl.conf;

    auth_basic           "databases-stack";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location = /health {
        auth_basic off;
        access_log off;
        add_header Content-Type text/plain;
        return 200 "healthy\n";
    }

    location = /ca.crt {
        auth_basic off;
        alias /etc/nginx/certs/ca.crt;
        add_header Content-Type application/x-x509-ca-cert;
        add_header Content-Disposition 'attachment; filename="databases-stack-ca.crt"';
    }

    # Kontrol düzlemi. Token'ı BURADA ekliyoruz: controller host'a port açmaz,
    # yani ona ancak bu satırdan geçilerek ulaşılabilir. Aynı docker ağındaki
    # başka bir container (ör. ele geçirilmiş bir panel) doğrudan denerse
    # token olmadığı için 401 alır.
    location /api/ {
        set $up_controller controller;
        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header X-Api-Token "${STACK_CONTROLLER_TOKEN}";
        # Motor aktivasyonu imaj çekmeyi gerektirebilir; dakikalar sürebilir.
        proxy_read_timeout 1800s;
        proxy_pass http://$up_controller:8000;
    }

    # Motor kataloğu. Dashboard normalde /api/catalog'u kullanır; controller
    # kapalıysa buraya düşer ve en azından motor listesini gösterebilir.
    location = /catalog.json {
        alias /etc/nginx/catalog.json;
        default_type application/json;
    }

    location / {
        root  /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
    }

    include /etc/nginx/snippets/inactive.conf;
}

# =============================================================================
# PANELLER — her biri kendi HTTPS portunda
# =============================================================================
# Alt yol (/pma/ gibi) yerine ayrı port kullanıldı: phpMyAdmin, pgAdmin, Kibana,
# Neo4j Browser gibi araçların alt-yolda çalışması ayrı ayrı base-path ayarı
# ister ve kırılgandır. Ayrı portta her uygulama kendi kökünde çalışır.
# Panellerin KENDİ portları host'a açılmaz; tek yol buradan geçer.

# --- 8081 phpMyAdmin (MariaDB) ----------------------------------------------
server {
    listen 8081 ssl; http2 on; server_name _;
    include /etc/nginx/snippets/ssl.conf;
    auth_basic "phpMyAdmin"; auth_basic_user_file /etc/nginx/.htpasswd;
    location / {
        set $up phpmyadmin;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://$up:80;
    }
    include /etc/nginx/snippets/inactive.conf;
}

