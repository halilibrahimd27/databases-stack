# --- 8083 Mongo Express (MongoDB) -------------------------------------------
server {
    listen 8083 ssl; http2 on; server_name _;
    include /etc/nginx/snippets/ssl.conf;
    auth_basic $panel_auth; auth_basic_user_file /etc/nginx/.htpasswd;
    location / {
        set $up mongo-express;
        # İSTİSNA: Mongo Express'in kendi basic auth'u gateway ile aynı
        # kimlik bilgisini kullanır (PANEL_USER/PANEL_PASSWORD). Başlığı
        # iletmek kullanıcıyı ikinci kez giriş yapmaktan kurtarır.
        #
        # AMA bu istisnanın bedeli var: Authorization başlığını tarayıcı, o
        # adrese giden HER isteğe kendiliğinden ekler ve HTTP auth çerez
        # olmadığı için SameSite kuralları ona işlemez. Yani panele bir kez
        # girmiş yöneticinin tarayıcısındaki kötü niyetli bir sayfa buraya
        # gizli bir form POST'u yollarsa, istek mongo-express tarafında
        # "kimliği doğrulanmış" sayılır; mongo-express 1.0.2'de bunu durduran
        # bir CSRF jetonu yok, koleksiyon/veritabanı silme uçları bu yoldan
        # tetiklenebilir. Diğer paneller proxy-panel.conf ile Authorization'ı
        # temizleyip kendi çerez oturumlarını kullandığı için (çerezlerde
        # SameSite=Lax varsayılanı geçerli) bu satırlara ihtiyaç duymaz.
        #
        # ÇAPRAZ-SİTE KAPISI. Buradan dönen yalnız gizli form POST'u değil:
        # mongo-express indeks silmeyi GET ile de sunuyor (dropIndex/compact/
        # reIndex), yani ölçüt yöntem DEĞİL, isteği kimin başlattığı.
        # Ayrıntı: $panel_from map'i ve snippets/panel-csrf.conf.
        include /etc/nginx/snippets/panel-csrf.conf;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://$up:8081;
    }
    include /etc/nginx/snippets/panel-csrf-page.conf;
    include /etc/nginx/snippets/inactive.conf;
}

