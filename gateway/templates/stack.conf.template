# --- 8084 RedisInsight (Redis) ----------------------------------------------
server {
    listen 8084 ssl; http2 on; server_name _;
    include /etc/nginx/snippets/ssl.conf;
    auth_basic $panel_auth; auth_basic_user_file /etc/nginx/.htpasswd;
    location / {
        set $up redis-insight;
        include /etc/nginx/snippets/proxy-panel.conf;
        proxy_pass http://$up:5540;
    }
    include /etc/nginx/snippets/inactive.conf;
}

# --- 8085 Adminer (evrensel — MSSQL, ClickHouse, MySQL, PostgreSQL) ---------
server {
    listen 8085 ssl; http2 on; server_name _;
    include /etc/nginx/snippets/ssl.conf;
    auth_basic $panel_auth; auth_basic_user_file /etc/nginx/.htpasswd;
    location / {
        set $up adminer;
        include /etc/nginx/snippets/proxy-panel.conf;
        proxy_read_timeout 3600s;   # uzun ALTER TABLE / import (ödünleşim: bkz. 8081)
        proxy_pass http://$up:8080;
    }
    include /etc/nginx/snippets/inactive.conf;
}

