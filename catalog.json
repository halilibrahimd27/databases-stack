        "replica_port": 3307,
        "note": "GTID tabanlı asenkron replikasyon. Replika read-only açılır."
      },
      "backup": {
        "supported": true,
        "kind": "logical",
        "ext": "sql.gz"
      },
      "connection": {
        "username": "root",
        "database": "defaultdb",
        "password_env": "MARIADB_PASSWORD"
      },
      "k8s": {
        "image_env": "MARIADB_VERSION",
        "data_path": "/var/lib/mysql",
        "port": 3306
      },
      "resources": {
        "min_mb": 512,
        "share": 0.2,
        "max_mb": 16384,
        "overhead_mb": 320,
        "panel_mb": 256,
        "exporter_mb": 64,
        "reserve": {
          "from": [
            "MARIADB_BUFFER_POOL"
          ],
          "plus_mb": 0,
          "note": "InnoDB buffer pool'unu sunucu AÇILIŞTA ayırır ve işletim sistemine geri vermez; MARIADB_MEM_LIMIT ise yalnızca üst sınırdır."
        },
        "tuning": [
          {
            "env": "MARIADB_MEM_LIMIT",
            "kind": "limit",
            "fmt": "M"
          },
          {
            "env": "MARIADB_BUFFER_POOL",
            "kind": "fraction",
            "factor": 0.6,
            "min_mb": 128,
            "fmt": "M"
          },
          {
            "env": "MARIADB_LOG_FILE_SIZE",
            "kind": "fraction",
            "factor": 0.12,
            "min_mb": 64,
            "max_mb": 2048,
            "fmt": "M"
          },
          {
            "env": "MARIADB_MAX_CONNECTIONS",
            "kind": "per_gb",
            "factor": 125,
            "min": 100,
            "max": 1000,
            "fmt": "int"
          }
        ]
      },
      "plain": {
        "title": "Klasik tablolu veri için en yaygın seçim",
